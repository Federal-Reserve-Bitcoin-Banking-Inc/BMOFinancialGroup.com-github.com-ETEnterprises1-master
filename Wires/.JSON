> Summary of Payment
Here's how you can create a summary of the payment:

typescript

>function summarizePayment(paymentIntent: Stripe.PaymentIntent) {
  return {
    id: paymentIntent.id,
    amount: paymentIntent.amount,
    currency: paymentIntent.currency,
    status: paymentIntent.status,
  };
}

# Example usage of summarizing a payment
makePayment(12081400, 'usd', 'tok_visa')
  .then((paymentIntent) => {
    const summary = summarizePayment(paymentIntent);
    console.log('Payment Summary:', summary);
  })
  .catch((error) => console.error('Error:', error));
